    "historyTimeline": [
      {
        "year": "Pre-1873",
        "title": "Barrio Dangla",
        "description": "Originally a thriving settlement of Bayambang known as \"Dangla,\" named after a medicinal shrub abundant in the area. Early settlers migrated from the Ilocos provinces via animal-drawn carts."
      },
      {
        "year": "1873",
        "title": "Petition for Independence",
        "description": "On April 1, 1873, local residents formally petitioned the Spanish colonial government to separate Barrio Dangla from Bayambang and establish an independent pueblo."
      },
      {
        "year": "1875",
        "title": "Founding of Alcala",
        "description": "Granted on September 20, 1875 via Royal Decree No. 682. The new municipality was named Alcala in honor of the hometown of the serving Governor of Pangasinan."
      },
      {
        "year": "1881",
        "title": "Holy Cross Parish Church",
        "description": "Construction of the historic brick Holy Cross Parish Church began in 1881, establishing an enduring religious and architectural landmark at the town center."
      },
      {
        "year": "Modern Era",
        "title": "Agri-Industrial Center along the Agno River",
        "description": "Anchored by rice, corn, tobacco, lowland vegetable farming, livestock, and the Alcala Agro-Industrial Complex in Brgy. Bersamin, Alcala remains a vital agricultural hub in Eastern Pangasinan."
      }
    ],
